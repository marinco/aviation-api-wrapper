# Copy to .env to override. Every value has a safe default in the Compose files.
REDIS_PASSWORD=change-me
UPSTREAM_BASE_URL=https://aviationweather.gov
# The upstream allows 100/min in total. With N app replicas, set this to 80/N.
UPSTREAM_RATE_LIMIT_PER_MINUTE=80
# Image tag Compose builds or runs.
APP_IMAGE=aviation-api:local
